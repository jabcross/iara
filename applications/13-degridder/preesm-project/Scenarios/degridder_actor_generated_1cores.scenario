<?xml version="1.0" encoding="UTF-8"?>
<scenario>
    <flags>
        <sizesAreInBit/>
    </flags>
    <files>
        <algorithm url="/degridder/Algo/degridder_actor.pi"/>
        <architecture url="/degridder/Archi/generated_1cores.slam"/>
        <codegenDirectory url="/degridder/Code/generated/"/>
    </files>
    <constraints excelUrl="">
        <constraintGroup>
            <operator name="Core0"/>
            <task name="degridder_actor/Degridder"/>
            <task name="degridder_actor/iterator"/>
        </constraintGroup>
    </constraints>
    <timings excelUrl="">
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/input_grid"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/vis_uvw_coord"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/support"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/kernels"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/config"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/Degridder"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/output_visibilities"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/iterator"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/broadcast_input_grid"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/broadcast_config_parallel"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/broadcast_kernels_parallel"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/broadcast_support_parallel"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="degridder_actor/broadcast_uvw_coord"/>
    </timings>
    <simuParams>
        <mainCore>Core0</mainCore>
        <mainComNode>shared_mem</mainComNode>
        <averageDataSize>1000</averageDataSize>
        <dataTypes>
            <dataType name="float2" size="8"/>
            <dataType name="int" size="32"/>
            <dataType name="int2" size="8"/>
            <dataType name="Config" size="8"/>
            <dataType name="float3" size="8"/>
        </dataTypes>
        <specialVertexOperators>
            <specialVertexOperator path="Core0"/>
        </specialVertexOperators>
    </simuParams>
    <parameterValues/>
    <papifyConfigs xmlUrl=""/>
    <energyConfigs xmlUrl="">
        <performanceObjective objectiveEPS="0.0"/>
        <peActorsEnergy/>
    </energyConfigs>
</scenario>
