            <task name="top_degridder/export_supports_to_csv"/>
            <task name="top_degridder/generate_kernels"/>
            <task name="top_degridder/degridder"/>
        </constraintGroup>
    </constraints>
    <timings excelUrl="">
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/config_struct_set_up"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/broadcast_config"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/visibility_host_set_up"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/convert_vis_to_csv"/>
