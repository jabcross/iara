        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/broadcast_kernels"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="top_degridder/broadcast_kernel_supports"/>
