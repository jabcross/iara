            <task name="top_degridder/export_image_to_csv_input_grid"/>
            <task name="top_degridder/export_image_to_csv_uv_grid"/>
            <task name="top_degridder/export_image_to_csv_uv_grid_shift"/>
            <task name="top_degridder/export_image_to_csv_reconstructed"/>
            <task name="top_degridder/export_image_to_csv_gridding"/>
