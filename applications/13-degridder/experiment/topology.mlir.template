!float2 = !llvm.struct<"struct.float2", (f32, f32)>
!float3 = !llvm.struct<"struct.float3", (f32, f32, f32)>
!int2 = !llvm.struct<"struct.int2", (i32, i32)>
!Config = !llvm.struct<"struct.Config", (i8, i32, i32, i32, i32, f64, ptr, ptr, i32, i32, i8, i8, i8, i8, i8, i8, i8, ptr, ptr, ptr, ptr, ptr, ptr, i8, i8, i32, i32, i8, f64, i32, f64, i32, i32, i32, f64, f64, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, i32, i32, f64, f64, f64, f64, f64, ptr, ptr, ptr, i32, ptr)>

// Sub-graph actor: receives its 4 sizing params from @run's node call (no
// default_params of its own — see 26-param-hierarchy's pattern). Derives
// number_sample_in_kernel/total_kernels_samples/num_visib_d_n_chunk locally
// via arith (NUM_KERNELS=17 and OVERSAMPLING_FACTOR=16 are true constants,
// not experiment params).
iara.actor @degridder_actor(%grid_size: i64, %num_visibilities: i64, %num_kernel_support: i64, %num_chunk: i64) {
  %c1 = arith.constant 1 : i64
  %c16 = arith.constant 16 : i64
  %c17 = arith.constant 17 : i64
  %nkp1 = arith.addi %num_kernel_support, %c1 : i64
  %nkp1_16 = arith.muli %nkp1, %c16 : i64
  %nsik = arith.muli %nkp1_16, %nkp1_16 : i64
  %tks = arith.muli %c17, %nsik : i64
  %nvdnc = arith.divsi %num_visibilities, %num_chunk : i64

  %tks_idx = arith.index_cast %tks : i64 to index
  %grid_size_idx = arith.index_cast %grid_size : i64 to index
  %num_visibilities_idx = arith.index_cast %num_visibilities : i64 to index
  %num_chunk_idx = arith.index_cast %num_chunk : i64 to index
  %nvdnc_idx = arith.index_cast %nvdnc : i64 to index

  %param_in_kernels = iara.in <%tks_idx> : tensor<?x!float2>
  %param_in_support = iara.in : tensor<17x!int2>
  %param_in_input_grid = iara.in <%grid_size_idx, %grid_size_idx> : tensor<?x?x!float2>
  %param_in_vis_uvw_coords = iara.in <%num_visibilities_idx> : tensor<?x!float3>
  %param_in_config = iara.in : !Config

  %kernels = iara.node @broadcast_kernels_parallel
    in %param_in_kernels: tensor<?x!float2>
    out tensor<?x?x!float2> sizes [%num_chunk_idx, %tks_idx]
  %support = iara.node @broadcast_support_parallel
    in %param_in_support: tensor<17x!int2>
    out tensor<?x17x!int2> sizes [%num_chunk_idx]
  %input_grid = iara.node @broadcast_input_grid
    in %param_in_input_grid: tensor<?x?x!float2>
    out tensor<?x?x?x!float2> sizes [%num_chunk_idx, %grid_size_idx, %grid_size_idx]
  %vis_uvw_coords = iara.node @broadcast_uvw_coord
    in %param_in_vis_uvw_coords: tensor<?x!float3>
    out tensor<?x?x!float3> sizes [%num_chunk_idx, %num_visibilities_idx]
  %config = iara.node @broadcast_config_parallel
    in %param_in_config: !Config
    out tensor<?x!Config> sizes [%num_chunk_idx]


  // Multi-rate edges: `in` carries the NUM_CHUNK-broadcast copy, `out`
  // collapses back to the single-chunk shape. Genuinely different rates,
  // resolved independently via out_dynamic_sizes (the EdgeOp fix this task
  // is about) — e_support/e_config/e_iterator need no size annotation at
  // all since their `out` has no dynamic dims (17 is a literal, !Config/i32
  // are non-tensor).
  %e_kernels = iara.edge %kernels : tensor<?x?x!float2> -> tensor<?x!float2> sizes [%tks_idx]
  %e_support = iara.edge %support : tensor<?x17x!int2> -> tensor<17x!int2>
  %e_input_grid = iara.edge %input_grid : tensor<?x?x?x!float2> -> tensor<?x?x!float2> sizes [%grid_size_idx, %grid_size_idx]
  %e_vis_uvw_coords = iara.edge %vis_uvw_coords : tensor<?x?x!float3> -> tensor<?x!float3> sizes [%num_visibilities_idx]
  %e_config = iara.edge %config : tensor<?x!Config> -> !Config


  %iterator = iara.node @iterator out tensor<?xi32> sizes [%num_chunk_idx]
  %e_iterator = iara.edge %iterator : tensor<?xi32> -> i32

  %output_visibilities = iara.node @std_degridding_parallel2
    in
      %e_kernels : tensor<?x!float2>,
      %e_support: tensor<17x!int2>,
      %e_input_grid : tensor<?x?x!float2>,
      %e_vis_uvw_coords : tensor<?x!float3>,
      %e_config: !Config,
      %e_iterator: i32
    out tensor<?x!float2> sizes [%nvdnc_idx]

  // The scatter edge: `in` is the per-chunk partial (num_visibilities /
  // num_chunk), `out` is the full array — the one edge whose out size is a
  // genuinely *different* computed value from its in size (not just a
  // NUM_CHUNK-dim collapse), the case that originally motivated this fix.
  %out = iara.edge %output_visibilities : tensor<?x!float2> -> tensor<?x!float2> sizes [%num_visibilities_idx]
  iara.out(%out : tensor<?x!float2>) <%num_visibilities_idx>
}


iara.actor @run(%grid_size: i64, %num_visibilities: i64, %num_kernel_support: i64, %num_chunk: i64) {
  %c1 = arith.constant 1 : i64
  %c16 = arith.constant 16 : i64
  %c17 = arith.constant 17 : i64
  %nkp1 = arith.addi %num_kernel_support, %c1 : i64
  %nkp1_16 = arith.muli %nkp1, %c16 : i64
  %nsik = arith.muli %nkp1_16, %nkp1_16 : i64
  %tks = arith.muli %c17, %nsik : i64

  %tks_idx = arith.index_cast %tks : i64 to index
  %grid_size_idx = arith.index_cast %grid_size : i64 to index
  %num_visibilities_idx = arith.index_cast %num_visibilities : i64 to index

  %kernels, %kernel_supports = iara.node @generate_kernel
    out
      tensor<?x!float2>,
      tensor<17x!int2>
    sizes [%tks_idx]

  %config = iara.node @config_struct_set_up
    out !Config

  %input_grid = iara.node @load_image_from_file
    in %config : !Config
    out tensor<?x?x!float2> sizes [%grid_size_idx, %grid_size_idx]

  %vis_uvw_coords = iara.node @visibility_host_set_up2
    in %config: !Config
    out tensor<?x!float3> sizes [%num_visibilities_idx]



  %fourier = iara.node @fft_shift_real_to_complex_actor
    in
      %input_grid: tensor<?x?x!float2>,
      %config : !Config
    out tensor<?x?x!float2> sizes [%grid_size_idx, %grid_size_idx]



  %uv_grid_out = iara.node @CUFFT_EXECUTE_FORWARD_C2C_actor
    in %fourier : tensor<?x?x!float2>
    out tensor<?x?x!float2> sizes [%grid_size_idx, %grid_size_idx]


  %uv_grid_out2 = iara.node @fft_shift_complex_to_complex_actor
    in %uv_grid_out: tensor<?x?x!float2>
    out tensor<?x?x!float2> sizes [%grid_size_idx, %grid_size_idx]


  %output_visibilities = iara.node @degridder_actor
    params
      %grid_size : i64,
      %num_visibilities : i64,
      %num_kernel_support : i64,
      %num_chunk : i64
    in
      %kernels : tensor<?x!float2>,
      %kernel_supports : tensor<17x!int2>,
      %uv_grid_out2 : tensor<?x?x!float2>,
      %vis_uvw_coords : tensor<?x!float3>,
      %config: !Config
    out tensor<?x!float2> sizes [%num_visibilities_idx]


  iara.node @convert_vis_to_csv
    in
      %output_visibilities : tensor<?x!float2>,
      %vis_uvw_coords : tensor<?x!float3>,
      %config : !Config

} { default_params = [{grid_size = GRID_SIZE_VALUE}, {num_visibilities = NUM_VISIBILITIES_VALUE}, {num_kernel_support = NUM_KERNEL_SUPPORT_VALUE}, {num_chunk = NUM_CHUNK_VALUE}] }
